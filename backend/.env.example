# Server
PORT=4000
NODE_ENV=development

# Database (Neon free Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/fitfuel?schema=public"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"

# Free LLM layer (Groq - https://console.groq.com)
GROQ_API_KEY=""

# CORS: comma-separated list of allowed origins for the web app.
# Add your deployed Vercel/Netlify/etc URL here in production.
ALLOWED_ORIGINS=http://localhost:5173
